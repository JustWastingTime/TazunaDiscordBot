APP_ID=
DISCORD_TOKEN=
PUBLIC_KEY=
OCR_SPACE_KEY=
# Required for /register, /profile, and /club leaderboard features.
# Create at uma.moe while logged in (API key page). Format: uma_k_...
UMA_API_KEY=

# Optional comma-separated guild IDs with premium leaderboard refresh (5-minute top-100 updates).
PREMIUM_GUILD_IDS=

# Premium club dashboard (same process as the bot). Discord OAuth app + public URL.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DASHBOARD_SESSION_SECRET=
# DASHBOARD_PUBLIC_URL=https://dash.example.com
# Seed Bunny club settings from UmaClubDashboard/config/clubs.json into this guild:
# DASHBOARD_SEED_GUILD_ID=
# DASHBOARD_MAX_CLUBS=8
# DASHBOARD_CACHE_MS=300000

# Bot owner Discord user ID(s) for /club setpremium, /refreshcache, and /admin.
# The admin dashboard only lets these accounts edit. Put your Discord user ID here.
BOT_OWNER_ID=
# GitHub fine-grained token with Contents read/write on this repo.
# The admin dashboard commits asset edits (skill.json, supporter.json, character.json, …) to this branch.
# GITHUB_TOKEN=
# GITHUB_REPO=JustWastingTime/TazunaDiscordBot
# GITHUB_BRANCH=main
# Optional comma-separated owner IDs (overrides/extends BOT_OWNER_ID when set).
# BOT_OWNER_IDS=
# Guild where owner-only commands (/signup, /gamba event, /gambacoin award, /setcm) appear.
# BOT_OWNER_GUILD_ID=

# Optional defaults for /skill CM map dropdown range (overridden by /setcm once used).
# SKILL_MAP_MIN_CM_NUMBER=18
# SKILL_MAP_MAX_CM_NUMBER=19

# Optional: sync quiz settings/category files from GitHub (no manual git pull needed on host).
# If enabled, quiz JSON files are refreshed locally on this interval.
QUIZ_REMOTE_SYNC_ENABLED=false
QUIZ_REMOTE_SYNC_INTERVAL_MS=300000
QUIZ_REMOTE_REPO=JustWastingTime/TazunaDiscordBot
QUIZ_REMOTE_BRANCH=main
# Optional GitHub token for private repos / higher API rate limits.
QUIZ_REMOTE_TOKEN=